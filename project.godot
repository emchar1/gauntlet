;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gauntlet"
run/main_scene="uid://csrqul1o4rknl"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*uid://cw76i22tp88yk"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

player="main player(s)"
zone="a room or a corridor"
world="walls or floor, the game world"
enemy="enemies"
hurtbox="hurtbox for enemies, players, spawners, destructibles"
hitbox="hitbox for enemies, players, spawners, destructibles"
door="used to open/close doors on room entry"

